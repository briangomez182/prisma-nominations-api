{
  "info": {
    "_postman_id": "817b491a-8644-5591-8efc-9aee6fe4a2c6",
    "name": "Prisma Nominations API",
    "description": "Escenarios E1–E7 de la prueba técnica. Los JWT de demo se generan solos (pre-request de la colección). Correr las carpetas en orden, o toda la colección con el Collection Runner. E8–E10 apagan servicios o generan volumen: ver scripts/demo.sh y scripts/load-test.sh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera los JWT de demo (HS256) en cada request, igual que scripts/mint-token.sh.",
          "// SOLO DEMO: en producción los tokens los emite el IdP corporativo (client credentials).",
          "const cryptoJs = require('crypto-js');",
          "const secret = pm.variables.get('jwt_secret');",
          "const issuer = pm.variables.get('jwt_issuer');",
          "const b64url = (words) => cryptoJs.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const json64 = (obj) => b64url(cryptoJs.enc.Utf8.parse(JSON.stringify(obj)));",
          "function mint(entityId, scope) {",
          "    const now = Math.floor(Date.now() / 1000);",
          "    const claims = { iss: issuer, sub: 'postman', iat: now, exp: now + 3600, scope: scope };",
          "    if (entityId) { claims.entity_id = entityId; }",
          "    const input = json64({ alg: 'HS256', typ: 'JWT' }) + '.' + json64(claims);",
          "    return input + '.' + b64url(cryptoJs.HmacSHA256(input, cryptoJs.enc.Base64.parse(secret)));",
          "}",
          "const entity = pm.variables.get('entity_id');",
          "pm.variables.set('token', mint(entity, 'nominations:write nominations:read'));",
          "pm.variables.set('token_other_entity', mint(pm.variables.get('other_entity_id'), 'nominations:write nominations:read'));",
          "pm.variables.set('token_read_only', mint(entity, 'nominations:read'));",
          "pm.variables.set('token_operator', mint(null, 'nominations:operate'));"
        ]
      }
    }
  ],
