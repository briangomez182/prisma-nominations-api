                  "const url = pm.variables.replaceIn('{{base_url}}/v1/nominations/{{rejected_id}}');",
                  "const auth = 'Bearer ' + pm.variables.get('token');",
                  "let tries = 0;",
                  "function poll() {",
                  "    pm.sendRequest({ url: url, method: 'GET', header: { Authorization: auth } }, (err, res) => {",
                  "        const status = !err && res.code === 200 ? res.json().status : null;",
                  "        if (!finals.includes(status) && ++tries < 20) { setTimeout(poll, 1000); }",
                  "        else if (EXTRA_WAIT) { setTimeout(() => {}, EXTRA_WAIT); }",
                  "    });",
                  "}",
                  "poll();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('REJECTED', () => pm.expect(pm.response.json().status).to.eql('REJECTED'));",
                  "pm.test('motivo normalizado', () => pm.expect(pm.response.json().rejection_reason).to.eql('CARD_NOT_ELIGIBLE'));",
                  "pm.test('no expone el código de ABM', () => pm.expect(pm.response.text()).to.not.include('ABM-030'));"
                ]
              }
            }
          ]
        }
      ]
    },
