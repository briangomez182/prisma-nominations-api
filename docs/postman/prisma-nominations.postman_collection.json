    {
      "name": "E4 - ABM aprueba",
      "description": "Estado final APPROVED y evento nomination.result.v1 (ver en Kafka UI).",
      "item": [
        {
          "name": "Esperar estado final y consultar",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/nominations/{{nomination_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "nominations",
                "{{nomination_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Consulta el estado hasta que llegue a un estado final (máx ~20 s). ABM es asincrónico.",
                  "const finals = [\"APPROVED\", \"REJECTED\", \"ABM_TIMEOUT\"];",
                  "const EXTRA_WAIT = 0;",
                  "const url = pm.variables.replaceIn('{{base_url}}/v1/nominations/{{nomination_id}}');",
                  "const auth = 'Bearer ' + pm.variables.get('token');",
                  "let tries = 0;",
                  "function poll() {",
                  "    pm.sendRequest({ url: url, method: 'GET', header: { Authorization: auth } }, (err, res) => {",
                  "        const status = !err && res.code === 200 ? res.json().status : null;",
                  "        if (!finals.includes(status) && ++tries < 20) { setTimeout(poll, 1000); }",
                  "        else if (EXTRA_WAIT) { setTimeout(() => {}, EXTRA_WAIT); }",
                  "    });",
                  "}",
                  "poll();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('APPROVED', () => pm.expect(pm.response.json().status).to.eql('APPROVED'));"
                ]
              }
            }
          ]
        }
      ]
    },
